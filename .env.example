# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Groq AI (OpenAI-compatible API)
AI_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_KEY=

# MongoDB
MONGODB_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=

# Email (forgot password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PolyGlot AI <noreply@polyglot.ai>"
